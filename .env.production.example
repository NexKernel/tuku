# ─────────────────────────────────────────────────────────────
# Tuku — PLANTILLA de producción (sin secretos)
# Copia a .env y rellena los valores reales, o replica en Dokploy → Environment.
# NO pongas credenciales reales en este archivo (se versiona en git).
# ─────────────────────────────────────────────────────────────

# App
APP_NAME="Tuku"
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Dominio real. El frontend hace proxy /api → backend (mismo origen, sin CORS).
BACKEND_CORS_ORIGINS=https://tuku.ose.lat
# Ruta relativa same-origin. Déjalo en /api/v1 (recomendado, un solo dominio).
VITE_API_URL=/api/v1

# Seguridad — genera uno: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REEMPLAZA_con_un_secreto_largo_y_aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# PostgreSQL (tu base de Dokploy). El backend fuerza el driver async.
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST_POSTGRES:5432/BASE

# Usuario demo con contraseña pública (estudiante@preu.pe). false en producción.
SEED_DEMO_USER=false

# Redis interno del stack
REDIS_URL=redis://tuku-redis:6379/0

# MinIO (S3)
MINIO_ENDPOINT=tuku-minio:9000
MINIO_ACCESS_KEY=REEMPLAZA
MINIO_SECRET_KEY=REEMPLAZA
MINIO_BUCKET=preu-media
MINIO_SECURE=false

# IA — proveedor: anthropic | openai | deepseek | gemini | echo (demo sin key)
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
# DeepSeek (API compatible con OpenAI): deepseek-chat (V3) | deepseek-reasoner (R1)
DEEPSEEK_API_KEY=REEMPLAZA_con_tu_key_de_DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Capacidad para alta demanda (ver docs/DEPLOY_DOKPLOY.md) ─────
# Procesos de Uvicorn ≈ 2 × núcleos de CPU del servidor.
WEB_CONCURRENCY=4
# Conexiones a Postgres = WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# Debe quedar por debajo de max_connections de tu Postgres (100 por defecto).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Llamadas simultáneas a la IA POR PROCESO (total = WEB_CONCURRENCY × este valor).
# Mantenlo menor que DB_POOL_SIZE + DB_MAX_OVERFLOW.
AI_MAX_CONCURRENCY=12
AI_QUEUE_TIMEOUT=30
AI_REQUEST_TIMEOUT=60
# Límites por minuto (por correo en login, por niño en el tutor).
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_TUTOR_PER_MIN=20
