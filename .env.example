# ─────────────────────────────────────────────────────────────
# PREU Mentor IA — variables de entorno
# Copia este archivo a .env y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# App
APP_NAME="PREU Mentor IA"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seguridad / JWT
SECRET_KEY=CAMBIAR_por_un_secreto_largo_y_aleatorio_de_64_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# PostgreSQL
POSTGRES_USER=preu
POSTGRES_PASSWORD=preu_dev_password
POSTGRES_DB=preu_mentor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Cadena completa (opcional; si se omite se arma con las de arriba)
# DATABASE_URL=postgresql+asyncpg://preu:preu_dev_password@localhost:5432/preu_mentor

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=preu-media
MINIO_SECURE=false

# IA — proveedor por defecto: anthropic | openai | gemini
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
